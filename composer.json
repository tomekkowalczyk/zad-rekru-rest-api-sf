{
    "name": "symfony/skeleton",
    "type": "project",
    "license": "MIT",
    "description": "A minimal Symfony project recommended to create bare bones applications",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "api-platform/doctrine-orm": "^5.0",
        "api-platform/symfony": "*",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7",
        "lexik/jwt-authentication-bundle": "^3.2",
        "nelmio/cors-bundle": "*",
        "symfony/asset": "7.4.*",
        "symfony/clock": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/doctrine-messenger": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/expression-language": "7.4.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "7.4.*",
        "symfony/intl": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/messenger": "7.4.*",
        "symfony/monolog-bundle": "*",
        "symfony/rate-limiter": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "infection/extension-installer": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "stan": "phpstan analyse --no-progress --memory-limit=1G",
        "deptrac": "deptrac analyse --config-file=deptrac.dist.yaml --no-progress",
        "rector": "rector process --dry-run --no-progress-bar",
        "rector:fix": "rector process --no-progress-bar",
        "test:unit": "phpunit",
        "test:behat": "behat --no-interaction",
        "test": [
            "@test:unit",
            "@test:behat"
        ],
        "mutation": "infection --threads=max --no-progress --show-mutations=10",
        "qa": [
            "@cs",
            "@stan",
            "@deptrac",
            "@rector",
            "@test",
            "@mutation"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": "true",
            "require": "7.4.*"
        }
    },
    "require-dev": {
        "behat/behat": "^4.0",
        "dama/doctrine-test-bundle": "^8.7",
        "deptrac/deptrac": "^4.7",
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "friends-of-behat/symfony-extension": "^2.7",
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.35.6",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.4",
        "rector/rector": "^2.7",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/maker-bundle": "^1.68",
        "webmozart/assert": "^2.5"
    },
    "scripts-descriptions": {
        "cs": "Checks the coding standard (PHP-CS-Fixer, dry run).",
        "cs:fix": "Applies the coding standard.",
        "stan": "Runs static analysis at PHPStan level max.",
        "deptrac": "Verifies the modular-monolith boundaries.",
        "rector": "Reports automated refactorings (dry run).",
        "rector:fix": "Applies automated refactorings.",
        "test": "Runs PHPUnit and Behat.",
        "qa": "Runs the full quality gate, exactly as CI does."
    }
}
